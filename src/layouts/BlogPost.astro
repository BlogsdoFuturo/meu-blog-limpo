---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main { width: calc(100% - 2em); max-width: 100%; margin: 0; }
			.hero-image { width: 100%; }
			.hero-image img { display: block; margin: 0 auto; border-radius: 12px; box-shadow: var(--box-shadow); }
			.prose { width: 720px; max-width: calc(100% - 2em); margin: auto; padding: 1em; color: rgb(var(--gray-dark)); }
			.title { margin-bottom: 1em; padding: 1em 0; text-align: center; line-height: 1; }
			.date { margin-bottom: 0.5em; color: rgb(var(--gray)); }
			.last-updated-on { font-style: italic; }
		</style>
		
		<style is:global>
			/* HIERARQUIA DE TIPOGRAFIA (DESKTOP) */
			.prose .title h1 { font-size: 2.6em; margin: 0 0 0.5em 0; color: #1e1e1e; font-weight: 800; line-height: 1.2; }
			.prose h2 { font-size: 1.8em; margin-top: 1.5em; margin-bottom: 0.5em; line-height: 1.3; color: #1e1e1e; font-weight: 700; }
			.prose h3 { font-size: 1.4em; margin-top: 1.2em; margin-bottom: 0.5em; line-height: 1.3; color: #1e1e1e; font-weight: 700; }
			.prose h4 { font-size: 1.2em; margin-top: 1em; margin-bottom: 0.5em; line-height: 1.3; color: #1e1e1e; font-weight: 700; }
			.prose p, .prose ul, .prose ol { font-size: 1.1em; line-height: 1.7; margin-bottom: 1.2em; }

			/* HIERARQUIA RIGOROSA PARA CELULAR */
			@media (max-width: 720px) {
				/* H1 cravado: Encaixa a palavra Microempreendedores e domina a tela */
				.prose .title h1 { font-size: 1.45em !important; line-height: 1.3 !important; }
				
				/* H2 submisso ao H1 (Doma os títulos dentro do texto) */
				.prose h2 { font-size: 1.25em !important; line-height: 1.3 !important; }
				
				/* H3 submisso ao H2 */
				.prose h3 { font-size: 1.1em !important; line-height: 1.3 !important; }
				.prose h4, .prose h5, .prose h6 { font-size: 1.05em !important; line-height: 1.3 !important; }
				
				/* Textos padrão */
				.prose p, .prose ul, .prose ol { font-size: 1em !important; line-height: 1.6 !important; }

				/* Blindagem absoluta contra quebra de palavras */
				.prose, .prose * {
					word-break: normal !important;
					-webkit-hyphens: none !important;
					-ms-hyphens: none !important;
					hyphens: none !important;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage} alt={title} />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							{pubDate && new Date(pubDate).toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric' })}
							{updatedDate && (<div class="last-updated-on">Atualizado em {new Date(updatedDate).toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric' })}</div>)}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>