---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Início</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/sobre">Sobre</HeaderLink>
			<HeaderLink href="/contato">Contato</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1.2em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
		color: #1d76a0; /* Azul da sua marca */
		font-weight: bold;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1em;
	}
	nav a {
		padding: 0.5em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
		font-weight: 500;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: #289b5d; /* Verde da sua marca */
	}
	.internal-links {
		display: flex;
		gap: 1em;
	}

	/* REGRAS PARA CELULAR (Telas menores que 600px) */
	@media (max-width: 600px) {
		nav {
			flex-direction: column; /* Coloca o título em cima e os links embaixo */
			gap: 1em; /* Dá um espaço entre o título e os links */
			padding: 1em 0.5em;
		}
		.internal-links {
			flex-wrap: wrap; /* Permite que os links pulem de linha se faltar espaço */
			justify-content: center; /* Centraliza os botões */
			gap: 0.5em; /* Reduz o espaço entre os botões no celular */
		}
	}
</style>