---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const getCategorySlug = (category: string) => {
	const lower = (category || '').toLowerCase();
	if (lower.includes('automação')) return 'automacao';
	if (lower.includes('inteligência')) return 'inteligencia-artificial';
	if (lower.includes('marketing')) return 'marketing';
	if (lower.includes('vendas')) return 'vendas';
	if (lower.includes('atendimento') || lower.includes('whatsapp')) return 'whatsapp';
	if (lower.includes('ferramentas')) return 'ferramentas';
	return 'geral';
};
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { width: 960px; max-width: calc(100% - 2em); margin: auto; padding: 3em 1em; }
			ul { display: flex; flex-wrap: wrap; gap: 2rem; list-style-type: none; margin: 0; padding: 0; }
			ul li { width: calc(50% - 1rem); }
			ul li * { text-decoration: none; transition: 0.2s ease; }
			ul li img { margin-bottom: 1rem; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); display: block; }
			ul li a { display: block; }
			.title { margin: 0; color: rgb(var(--black)); line-height: 1.2; font-size: 1.563em; margin-bottom: 0.2em; }
			.date { margin: 0; color: rgb(var(--gray)); }
			ul li a:hover h4, ul li a:hover .date { color: #1d76a0; }
			
			.categoria-badge {
				display: inline-block;
				background-color: #289b5d;
				color: white !important;
				padding: 0.3em 1em;
				border-radius: 20px;
				font-size: 0.85em;
				font-weight: bold;
				margin-bottom: 0.8em;
				text-transform: uppercase;
			}
			.categoria-link { display: inline-block; margin-bottom: 0.5rem; }

			@media (max-width: 720px) {
				ul li { width: 100%; margin-bottom: 2em; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => {
							const categoriaNome = post.data.category || 'Automação e Produtividade';
							const categoriaSlug = getCategorySlug(categoriaNome);
							
							return (
								<li>
									<a href={`/blog/${post.slug || post.id}/`}>
										<img width={720} height={360} src={post.data.heroImage} alt={post.data.title} />
									</a>
									<a href={`/blog/${categoriaSlug}/`} class="categoria-link">
										<span class="categoria-badge">{categoriaNome}</span>
									</a>
									<a href={`/blog/${post.slug || post.id}/`}>
										<h4 class="title">{post.data.title}</h4>
										<p class="date">
											{post.data.pubDate.toLocaleDateString('pt-BR', {
												year: 'numeric',
												month: 'long',
												day: 'numeric',
											})}
										</p>
									</a>
								</li>
							);
						})
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>