---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={`Contato | ${SITE_TITLE}`} description="Entre em contato conosco." />
		<style>
			main { width: 960px; max-width: calc(100% - 2em); margin: auto; padding: 3em 1em; text-align: center; }
			.prose { max-width: 720px; margin: auto; color: rgb(var(--gray-dark)); }
			h1 { margin-bottom: 0.5em; color: rgb(var(--black)); }
			p { line-height: 1.6; margin-bottom: 2em; }
			
			.contact-box {
				background: #f4f4f5;
				padding: 2.5em 2em;
				border-radius: 12px;
				margin-top: 2em;
				border-top: 4px solid #1d76a0; /* Detalhe em Azul */
			}
			.contact-box h3 {
				margin-top: 0;
				color: rgb(var(--black));
			}
			.email-link {
				color: #1d76a0; /* Azul da sua marca */
				font-size: 1.3em;
				font-weight: bold;
				text-decoration: none;
				word-break: break-all;
			}
			.email-link:hover {
				text-decoration: underline;
			}
			
			/* Estilos do Botão de Copiar */
			.btn-copiar {
				background-color: #289b5d; /* Verde da sua marca */
				color: white;
				border: none;
				padding: 0.8em 1.5em;
				font-size: 1em;
				border-radius: 8px;
				cursor: pointer;
				font-weight: bold;
				margin-top: 1.5em;
				transition: background-color 0.3s ease;
			}
			.btn-copiar:hover {
				background-color: #1d76a0; /* Fica Azul ao passar o mouse */
			}
			#mensagem-sucesso {
				color: #289b5d;
				font-weight: bold;
				margin-top: 10px;
				display: none; /* Fica escondido até a pessoa clicar */
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="prose">
				<h1>Contato</h1>
				<p>Tem alguma dúvida, sugestão ou proposta de parceria? Adoraríamos ouvir você!</p>

				<div class="contact-box">
					<h3>Fale Conosco</h3>
					<p>A maneira mais rápida de falar com a nossa equipe é enviando um e-mail para:</p>
					
					<div>
						<a href="mailto:blogsdofuturo@gmail.com" class="email-link">blogsdofuturo@gmail.com</a>
					</div>
					
					<button id="btn-copiar" class="btn-copiar">📋 Copiar E-mail</button>
					<p id="mensagem-sucesso">✅ E-mail copiado com sucesso!</p>
					
					<p><small style="display:block; margin-top:2em;">Dica: No celular, basta clicar no e-mail. No computador, use o botão de copiar!</small></p>
				</div>
			</div>
		</main>
		<Footer />

		<!-- O script mágico que faz o botão copiar o texto -->
		<script>
			const btnCopiar = document.getElementById('btn-copiar');
			const mensagemSucesso = document.getElementById('mensagem-sucesso');

			if (btnCopiar && mensagemSucesso) {
				btnCopiar.addEventListener('click', () => {
					navigator.clipboard.writeText('blogsdofuturo@gmail.com').then(() => {
						mensagemSucesso.style.display = 'block';
						// Esconde a mensagem de sucesso depois de 3 segundos
						setTimeout(() => {
							mensagemSucesso.style.display = 'none';
						}, 3000);
					});
				});
			}
		</script>
	</body>
</html>